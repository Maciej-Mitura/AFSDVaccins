{
  "name": "@vaccin-delivery/pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 PWA for Vaccinatie-levering",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:production": "node --experimental-strip-types ./scripts/validate-production-env.mjs && vue-tsc --build && vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "build:e2e": "vite build",
    "test:e2e:pwa:preview": "node ./scripts/run-e2e-preview.mjs",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:hardcoded-strings": "node ./scripts/audit-hardcoded-strings.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@nuxt/ui": "^4.0.1",
    "@vaccin-delivery/types": "0.0.0",
    "@vue/apollo-composable": "^4.2.2",
    "echarts": "^6.1.0",
    "firebase": "^12.16.0",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.1.0",
    "idb": "^8.0.3",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.7",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^4.5.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
