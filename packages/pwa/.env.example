# Local Vite development (HTTP/WS is expected here).
# Production Firebase Hosting builds must use HTTPS/WSS via:
#   npm run build:pwa:production
# which validates VITE_* before building.
VITE_BACKEND_URL=http://localhost:3000/graphql
VITE_BACKEND_WS_URL=ws://localhost:3000/graphql
# Playwright browser E2E only — never set in normal development/production builds
# VITE_E2E_AUTH_BYPASS=true
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_STORAGE_BUCKET=replace-me.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# ---- Phase 27B Web Push (public VAPID key only) ----
# Generate: npx web-push generate-vapid-keys
# Copy ONLY the public key here. Never put the private key in the PWA.
# The same public key must match WEB_PUSH_VAPID_PUBLIC_KEY on the API.
# Local: leave unset (or set) — push UI shows unavailable until configured.
# Local SW (required for background OS push on Vite): VITE_PWA_DEV=true
# Production with push: set VITE_WEB_PUSH_ENABLED=true and the public key.
# VITE_PWA_DEV=false
# VITE_WEB_PUSH_ENABLED=false
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
