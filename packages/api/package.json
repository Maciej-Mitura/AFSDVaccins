{
  "name": "@vaccin-delivery/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS GraphQL API for Vaccinatie-levering",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "generate:schema": "nest build && cross-env GENERATE_SCHEMA_ONLY=true NODE_ENV=test PORT=3000 URL_FRONTEND=http://localhost:5173 DB_HOST=mongodb://localhost:27017 DB_NAME=vaccin-delivery DELIVERY_QR_SIGNING_SECRET=test-only-delivery-qr-signing-secret-32b! PUSH_PROVIDER=fake node dist/main.js --generate-schema-only",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./jest-e2e.json --runInBand --forceExit",
    "test:e2e:security": "cross-env NODE_ENV=test jest --config ./jest-e2e-security.json --runInBand --forceExit",
    "test:e2e:pwa:stack": "npm run build && cross-env NODE_ENV=test node dist/playwright-e2e/start-api.js",
    "seed:database:all": "nest build && node dist/cli.js",
    "seed:database:cli": "node dist/cli.js",
    "bootstrap:database:demo": "nest build && node dist/bootstrap-cli.js",
    "bootstrap:database:demo:cli": "node dist/bootstrap-cli.js",
    "diagnose:voice-reports:azure": "ts-node --transpile-only scripts/diagnose-voice-reports-azure.ts",
    "test:voice-reports:azure-storage": "ts-node --transpile-only scripts/test-voice-reports-azure-storage.ts",
    "test:voice-reports:azure-speech": "ts-node --transpile-only scripts/test-voice-reports-azure-speech.ts",
    "test:voice-reports:azure": "ts-node --transpile-only scripts/test-voice-reports-azure.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@as-integrations/express5": "^1.1.2",
    "@azure-rest/ai-vision-image-analysis": "^1.0.0-beta.3",
    "@azure/core-auth": "^1.11.0",
    "@azure/storage-blob": "^12.33.0",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "^14.1.0",
    "graphql": "^16.11.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.1.0",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "joi": "^17.13.3",
    "keyv": "^5.6.0",
    "mongodb": "^6.16.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.7",
    "@types/express": "^5.0.0",
    "@types/image-size": "^0.7.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/passport-http-bearer": "^1.0.42",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jsqr": "^1.4.0",
    "mongodb-memory-server": "^11.2.0",
    "pngjs": "^5.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^firebase-admin/app$": "<rootDir>/authentication/__mocks__/firebase-admin-app.ts",
      "^firebase-admin/auth$": "<rootDir>/authentication/__mocks__/firebase-admin-auth.ts"
    }
  }
}
