NODE_ENV=development
PORT=3000
URL_FRONTEND=http://localhost:5173
# Local Mongo (Compose/dev). Atlas example for public demo (URL-encode special chars in user/password).
# DB_NAME selects the database even when the URI has no path (or only query params):
# DB_HOST=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_HOST=mongodb://localhost:27017
DB_NAME=vaccin-delivery

# Local / Docker Compose: path to Firebase Admin service-account JSON (preferred locally).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/or/container/path/firebase-service-account.json

# Railway / PaaS: raw service-account JSON OR base64-encoded JSON (never commit real values).
# Precedence: FIREBASE_SERVICE_ACCOUNT_JSON → GOOGLE_APPLICATION_CREDENTIALS → startup failure.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Express trust proxy. Local default: disabled. Railway single-service: TRUST_PROXY=1
# (do not use true unless you understand multi-hop IP spoofing risks).
# TRUST_PROXY=1

# Development seed CLI only (npm run seed:database:all)
ALLOW_DATABASE_SEED=false

# One-off production/demo bootstrap only (npm run bootstrap:database:demo).
# Never set on the long-running API. Never enable in Docker CMD / Railway start.
ALLOW_DATABASE_BOOTSTRAP=false
# CONFIRM_DATABASE_BOOTSTRAP=BOOTSTRAP_PUBLIC_DEMO_DATABASE

# Playwright browser E2E stack only (also requires NODE_ENV=test)
# ALLOW_E2E_AUTH_BYPASS=false

# Pharmacist/courier demo accounts (+ personal ADMIN create-if-missing)
SEED_DEMO_PASSWORD=change-me-demo-only
# Teacher/evaluator ADMIN (docent@howest.be) — separate from demo password
SEED_TEACHER_ADMIN_PASSWORD=change-me-teacher-only

# Personal evaluation-owner ADMIN (email from env — never hardcoded in source)
SEED_PERSONAL_ADMIN_EMAIL=you@example.com
# Optional: reuse an existing Firebase Auth user for the personal ADMIN
# SEED_PERSONAL_ADMIN_FIREBASE_UID=

# Optional: link other seed accounts to existing Firebase UIDs (omit to resolve by email)
# SEED_DOCENT_FIREBASE_UID=
# SEED_APOTHEKER1_FIREBASE_UID=
# SEED_APOTHEKER2_FIREBASE_UID=
# SEED_APOTHEKER3_FIREBASE_UID=
# SEED_BEZORGER1_FIREBASE_UID=
# SEED_BEZORGER2_FIREBASE_UID=

# ---- Phase 22 security / performance (optional; safe defaults apply) ----
# Throttler TTL values are milliseconds (@nestjs/throttler v6).
# THROTTLE_DEFAULT_TTL_MS=60000
# THROTTLE_DEFAULT_LIMIT=120
# THROTTLE_STRICT_TTL_MS=60000
# THROTTLE_STRICT_LIMIT=20
# Cache TTL values are milliseconds (cache-manager v7).
# CACHE_DEFAULT_TTL_MS=30000
# CACHE_REFERENCE_TTL_MS=60000
# GRAPHQL_MAX_DEPTH=12
# GRAPHQL_MAX_COMPLEXITY=500
# Authoritative Express JSON/urlencoded limit (b|kb|mb|gb, case-insensitive; max 32mb).
# Applies with or without Content-Length. Media uploads configured separately in Phase 25.
# API_JSON_BODY_LIMIT=1mb

# ---- Phase 25B/25C/25D vaccine image providers (optional; safe defaults apply) ----
# Local/test default: fake (in-memory; never calls Azure).
# Production: azure only (fake is rejected by env validation).
# VACCINE_IMAGE_ANALYSIS_PROVIDER=fake
# VACCINE_IMAGE_STORAGE_PROVIDER=fake

# Azure Blob Storage (required when VACCINE_IMAGE_STORAGE_PROVIDER=azure / production).
# Container must already exist and remain private (anonymous access disabled).
# Connection string must include AccountName + AccountKey (needed for short-lived read SAS).
# Never commit real connection strings. Never log them.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=vaccine-images
# Short-lived catalogue read URL TTL (seconds); bounded 60–3600; default 900.
# AZURE_STORAGE_READ_URL_TTL_SECONDS=900

# Azure AI Vision Image Analysis 4.0 (required when VACCINE_IMAGE_ANALYSIS_PROVIDER=azure / production).
# Endpoint must be HTTPS. Never commit real keys. Never log the key or full request bodies.
# AZURE_VISION_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
# AZURE_VISION_KEY=<subscription-key>
# Analysis HTTP timeout (milliseconds); bounded 1000–30000; default 10000.
# AZURE_VISION_TIMEOUT_MS=10000
