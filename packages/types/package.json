{
  "name": "@vaccin-delivery/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared GraphQL generated types for Vaccinatie-levering",
  "types": "./dist/graphql.ts",
  "exports": {
    ".": "./dist/graphql.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "graphql-codegen --config src/codegen.ts",
    "build": "npm run generate",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typed-document-node": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "graphql": "^16.11.0",
    "typescript": "~5.8.0"
  }
}
