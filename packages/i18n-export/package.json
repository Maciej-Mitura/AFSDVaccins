{
  "name": "@vaccin-delivery/i18n-export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only Google Sheets → locale JSON exporter for Vaccinatie-levering (not a runtime dependency)",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "export": "tsx src/index.ts",
    "sync:keys": "tsx src/sync-keys.ts",
    "build": "npm run export",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
}
