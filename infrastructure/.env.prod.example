# Copy to infrastructure/.env.prod (gitignored) and fill in local values.
# Never commit real secrets, passwords, or personal absolute paths into Git.
#
# Usage:
#   cp infrastructure/.env.prod.example infrastructure/.env.prod
#   docker compose -f infrastructure/docker-compose-production.yml --env-file infrastructure/.env.prod up -d --build

# ---- published ports (browser-visible) ----
API_PORT=3000
PWA_PORT=8080

# ---- API runtime ----
# Must match the URL the browser uses to open the PWA (CORS + cookies).
URL_FRONTEND=http://localhost:8080

# Separate production-like demo database (not the host development DB name).
DB_NAME=vaccin-delivery-production-demo

# Absolute path on the Docker HOST to your Firebase Admin service-account JSON.
# Mounted read-only into the API container. Do not put the JSON inside the repo.
# Example (adjust to your machine):
# FIREBASE_CREDENTIALS_HOST_PATH=C:/path/to/your-firebase-adminsdk.json
FIREBASE_CREDENTIALS_HOST_PATH=

# Phase 22 security / performance (optional — API defaults are safe for demo).
# TTL values are milliseconds. Uncomment to override.
# THROTTLE_DEFAULT_TTL_MS=60000
# THROTTLE_DEFAULT_LIMIT=120
# THROTTLE_STRICT_TTL_MS=60000
# THROTTLE_STRICT_LIMIT=20
# CACHE_DEFAULT_TTL_MS=30000
# CACHE_REFERENCE_TTL_MS=60000
# GRAPHQL_MAX_DEPTH=12
# GRAPHQL_MAX_COMPLEXITY=500
# Authoritative Express JSON/urlencoded limit (applies without Content-Length; media uploads Phase 25).
# API_JSON_BODY_LIMIT=1mb

# ---- Phase 25B/25C/25D vaccine image providers (optional; API defaults apply) ----
# Local Compose default remains fake unless you set azure + Azure vars on the API.
# Production / Railway must use azure and set the Azure variables below.
# VACCINE_IMAGE_ANALYSIS_PROVIDER=fake
# VACCINE_IMAGE_STORAGE_PROVIDER=fake
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=vaccine-images
# AZURE_STORAGE_READ_URL_TTL_SECONDS=900
# AZURE_VISION_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
# AZURE_VISION_KEY=<subscription-key>
# AZURE_VISION_TIMEOUT_MS=10000

# Phase 26A — delivery QR HMAC signing (backend-only; never expose to PWA).
# Required in production (min 32 characters). Never commit real values. Never log.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DELIVERY_QR_SIGNING_SECRET=replace-with-at-least-32-cryptographically-random-bytes

# Phase 27A — Web Push VAPID (production requires webpush; never commit real keys).
# Generate: npx web-push generate-vapid-keys
# PUSH_PROVIDER=webpush
# WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# WEB_PUSH_SUBJECT=mailto:ops@example.com

# ---- PWA build-time public configuration (embedded in the static bundle) ----
# Changing these requires rebuilding the PWA image.
# Browser talks to the published API port — not the Docker-internal hostname "api".
VITE_BACKEND_URL=http://localhost:3000/graphql
VITE_BACKEND_WS_URL=ws://localhost:3000/graphql

VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_STORAGE_BUCKET=replace-me.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Do NOT set VITE_E2E_AUTH_BYPASS here. Production builds must never enable it.

# ---- one-off bootstrap / seed only (NOT used by the long-running production API) ----
# Public demo (Atlas + Railway): use ALLOW_DATABASE_BOOTSTRAP + confirmation phrase.
# See docs/deployment.md. Local Compose presentation can still use ALLOW_DATABASE_SEED
# with NODE_ENV=development on a one-off container.
#
# ALLOW_DATABASE_BOOTSTRAP=true
# CONFIRM_DATABASE_BOOTSTRAP=BOOTSTRAP_PUBLIC_DEMO_DATABASE
# SEED_DEMO_PASSWORD=change-me-demo-only
# SEED_TEACHER_ADMIN_PASSWORD=change-me-teacher-only
# SEED_PERSONAL_ADMIN_EMAIL=you@example.com
# SEED_PERSONAL_ADMIN_FIREBASE_UID=
# SEED_DOCENT_FIREBASE_UID=
# SEED_APOTHEKER1_FIREBASE_UID=
# SEED_APOTHEKER2_FIREBASE_UID=
# SEED_APOTHEKER3_FIREBASE_UID=
# SEED_BEZORGER1_FIREBASE_UID=
# SEED_BEZORGER2_FIREBASE_UID=
