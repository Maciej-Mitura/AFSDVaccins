# Safe CI-only Compose env — placeholders only. Never put real credentials here.
# Used by `.github/workflows/ci-docker-smoke.yml` for `docker compose config`
# and documented local dry-runs. CI rewrites FIREBASE_CREDENTIALS_HOST_PATH to an
# absolute workspace path pointing at ci-compose-credential.placeholder.json.

API_PORT=3000
PWA_PORT=8080
URL_FRONTEND=http://localhost:8080
DB_NAME=vaccin-delivery-production-demo

# Overridden in CI with an absolute path; local dry-run may set this to the
# placeholder file under infrastructure/ (path relative to the compose project).
FIREBASE_CREDENTIALS_HOST_PATH=./ci-compose-credential.placeholder.json

VITE_BACKEND_URL=http://localhost:3000/graphql
VITE_BACKEND_WS_URL=ws://localhost:3000/graphql
VITE_FIREBASE_API_KEY=ci-placeholder
VITE_FIREBASE_AUTH_DOMAIN=ci-placeholder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ci-placeholder
VITE_FIREBASE_STORAGE_BUCKET=ci-placeholder.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Phase 26A — CI placeholder only (not a real secret; compose config interpolation).
DELIVERY_QR_SIGNING_SECRET=ci-placeholder-delivery-qr-signing-secret-32b

# Phase 27A — CI VAPID placeholders only (not real keys; compose config interpolation).
PUSH_PROVIDER=webpush
WEB_PUSH_VAPID_PUBLIC_KEY=BNcRdtreKN2ymJxwWZiOrQbKYi-U1WUPVP_vJKdF8n0abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOP
WEB_PUSH_VAPID_PRIVATE_KEY=ci-placeholder-vapid-private-key-min-40-chars!!
WEB_PUSH_SUBJECT=mailto:ci@example.com

# Do NOT set VITE_E2E_AUTH_BYPASS. Production / CI image builds must never enable it.
# Do NOT set SEED_* passwords here.
