{
  "name": "vaccin-delivery",
  "version": "0.0.0",
  "private": true,
  "description": "Vaccinatie-levering exam monorepo — vaccine ordering and delivery platform",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "node --input-type=module -e \"try { const { default: husky } = await import('husky'); husky(); } catch { /* omit=dev / Docker stages without husky */ }\"",
    "format": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "workspaces": "npm query .workspace",
    "workspaces:list": "npm ls --workspaces --depth=0",
    "dev": "concurrently -n api,pwa -c blue,green --kill-others-on-fail \"npm run dev:api\" \"npm run dev:pwa\"",
    "generate:schema": "npm run generate:schema --workspace=@vaccin-delivery/api",
    "generate:types": "npm run generate --workspace=@vaccin-delivery/types",
    "generate:graphql": "npm run generate:schema && npm run generate:types",
    "dev:api": "npm run dev --workspace=@vaccin-delivery/api",
    "dev:pwa": "npm run dev --workspace=@vaccin-delivery/pwa",
    "build:api": "npm run build --workspace=@vaccin-delivery/api",
    "build:pwa": "npm run generate:graphql && npm run build --workspace=@vaccin-delivery/pwa",
    "build:pwa:production": "npm run generate:graphql && npm run build:production --workspace=@vaccin-delivery/pwa",
    "validate:production-readiness": "node --test infrastructure/production-readiness.validation.test.mjs",
    "bootstrap:database:demo": "npm run bootstrap:database:demo --workspace=@vaccin-delivery/api",
    "export:i18n": "npm run export --workspace=@vaccin-delivery/i18n-export",
    "audit:i18n": "npm run audit:i18n --workspace=@vaccin-delivery/pwa",
    "sync:i18n:keys": "npm exec --workspace=@vaccin-delivery/i18n-export -- tsx src/sync-keys.ts",
    "lint:api": "npm run lint --workspace=@vaccin-delivery/api",
    "lint:pwa": "npm run lint --workspace=@vaccin-delivery/pwa",
    "lint:i18n": "npm run lint --workspace=@vaccin-delivery/i18n-export",
    "typecheck:api": "npm run typecheck --workspace=@vaccin-delivery/api",
    "typecheck:pwa": "npm run generate:graphql && npm run typecheck --workspace=@vaccin-delivery/pwa",
    "typecheck:i18n": "npm run typecheck --workspace=@vaccin-delivery/i18n-export",
    "test:api": "npm run test --workspace=@vaccin-delivery/api",
    "test:e2e:api": "npm run test:e2e --workspace=@vaccin-delivery/api && npm run test:e2e:security --workspace=@vaccin-delivery/api",
    "test:api:e2e": "npm run test:e2e:api",
    "test:pwa": "npm run test --workspace=@vaccin-delivery/pwa",
    "test:i18n": "npm run test --workspace=@vaccin-delivery/i18n-export",
    "test:e2e:pwa": "playwright test",
    "test:e2e:pwa:ui": "playwright test --ui",
    "test:e2e:pwa:report": "playwright show-report",
    "prepush:check": "npm run typecheck:api && npm run typecheck:pwa && npm run test:api && npm run test:pwa",
    "seed:database:all": "npm run seed:database:all --workspace=@vaccin-delivery/api",
    "test:docker:safety": "node --test infrastructure/docker-production.safety.test.mjs",
    "diagnose:voice-reports:azure": "npm run diagnose:voice-reports:azure --workspace=@vaccin-delivery/api",
    "diagnose:route-template-assignments": "npm run diagnose:route-template-assignments --workspace=@vaccin-delivery/api",
    "repair:route-template-assignments": "npm run repair:route-template-assignments --workspace=@vaccin-delivery/api",
    "seed:courier-analytics-demo": "npm run seed:courier-analytics-demo --workspace=@vaccin-delivery/api",
    "test:voice-reports:azure-storage": "npm run test:voice-reports:azure-storage --workspace=@vaccin-delivery/api",
    "test:voice-reports:azure-speech": "npm run test:voice-reports:azure-speech --workspace=@vaccin-delivery/api",
    "test:voice-reports:azure": "npm run test:voice-reports:azure --workspace=@vaccin-delivery/api"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": "prettier --write",
    "packages/api/**/*.ts": "eslint --config packages/api/eslint.config.mjs --no-warn-ignored",
    "packages/pwa/**/*.{ts,vue}": "eslint --config packages/pwa/eslint.config.ts --no-warn-ignored",
    "packages/i18n-export/**/*.ts": "eslint --config packages/i18n-export/eslint.config.mjs --no-warn-ignored"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  }
}
